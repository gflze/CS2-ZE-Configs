{
	// Kill epick blockers when round starts
	"modify": [
		{
			"match": {
				"classname": "logic_auto"
			},
			"insert": {
				"io": [
					{
						"outputname": "OnMapSpawn",
						"targetname": "Staff_*_Epicker",
						"inputname": "Kill",
						"delay": 15.0,
						"timestofire": 1
					}
				]
			}
		}
	],
	// fix warmup never ending
	"add": {
		"classname": "info_map_parameters",
		"uselocaloffset": "false",
		"origin": "-10264 -1136 2057",
		"angles": "0 0 0",
		"scales": "1 1 1"
	},
	"modify": {
		"match": {
			"classname": "logic_relay",
			"targetname": "[PR#]Warmup_Relay"
		},
		"insert": {
			"io": [
				{
					"outputname": "OnUser2",
					"targetname": "info_map_parameters",
					"inputname": "FireWinCondition",
					"overrideparam": "10",
					"delay": 40.0,
					"timestofire": 1
				}
			]
		}
	}
}
